# Cloudflare Pages Environment Variables (.dev.vars for local development)
# Add these variables in Cloudflare Dashboard:
# Workers & Pages -> clothmatics -> Settings -> Environment variables

# 1. Shopping Search Provider APIs (Google Shopping):
# Serper.dev (server.dev) API Key (Primary or Equal Fallback):
SERPER_API_KEY=your_serper_api_key_here

# SerpApi API Key (Optional / Alternative):
# SERPAPI_API_KEY=your_serpapi_api_key_here

# Preferred Provider (Optional: "auto", "serper", or "serpapi"):
# SHOPPING_PROVIDER=auto

# 2. Gemini AI API Key (for intelligent outfit styling combinations):
# GEMINI_API_KEY=your_gemini_api_key_here
